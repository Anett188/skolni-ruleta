<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Školní ruleta</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      color: #20243a;
      background: linear-gradient(135deg, #f7f4ff, #e5f7ff);
    }
    .app {
      width: min(100%, 620px);
      text-align: center;
      background: rgba(255,255,255,.88);
      padding: clamp(20px, 5vw, 38px);
      border-radius: 28px;
      box-shadow: 0 18px 55px rgba(42, 49, 95, .14);
    }
    h1 { margin: 0 0 8px; font-size: clamp(1.8rem, 5vw, 2.5rem); }
    .subtitle { margin: 0 0 24px; color: #666b83; }
    .wheel-wrap {
      position: relative;
      width: min(100%, 420px);
      aspect-ratio: 1;
      margin: 0 auto 24px;
    }
    canvas {
      width: 100%;
      height: 100%;
      display: block;
      filter: drop-shadow(0 8px 12px rgba(35, 41, 77, .18));
    }
    .pointer {
      position: absolute;
      z-index: 2;
      top: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 17px solid transparent;
      border-right: 17px solid transparent;
      border-top: 34px solid #252943;
      filter: drop-shadow(0 3px 2px rgba(0,0,0,.18));
    }
    button {
      border: 0;
      border-radius: 999px;
      padding: 15px 34px;
      background: #6655e8;
      color: white;
      font-size: 1.08rem;
      font-weight: 800;
      letter-spacing: .06em;
      cursor: pointer;
      box-shadow: 0 7px 0 #4939bd;
      transition: transform .15s, box-shadow .15s, opacity .15s;
    }
    button:hover { transform: translateY(-2px); box-shadow: 0 9px 0 #4939bd; }
    button:active { transform: translateY(4px); box-shadow: 0 3px 0 #4939bd; }
    button:disabled { opacity: .65; cursor: wait; transform: none; }
    .result {
      min-height: 58px;
      margin-top: 24px;
      padding: 15px;
      border-radius: 16px;
      background: #f2f0ff;
      font-size: 1.15rem;
      font-weight: 750;
    }
    .result span { color: #6655e8; }
    @media (max-width: 420px) {
      .app { padding: 20px 14px; }
      button { width: 100%; }
    }
  </style>
</head>
<body>
  <main class="app">
    <h1>🎡 Školní ruleta</h1>
    <p class="subtitle">Co tě dneska čeká? Roztoč kolo a zjisti to!</p>

    <div class="wheel-wrap">
      <div class="pointer" aria-hidden="true"></div>
      <canvas id="wheel" width="600" height="600" aria-label="Kolo se šesti možnostmi"></canvas>
    </div>

    <button id="spinButton">ROZTOČIT</button>
    <div class="result" id="result" aria-live="polite">Tvůj osud čeká… 👀</div>
  </main>

  <script>
    const options = [
      { text: "Písemka", color: "#ff6b6b" },
      { text: "Přestávka", color: "#ffb84d" },
      { text: "Domácí úkol", color: "#ffe66d" },
      { text: "Jednička", color: "#4ecdc4" },
      { text: "Pětka", color: "#5b8def" },
      { text: "Volná hodina", color: "#a879e8" }
    ];

    const canvas = document.getElementById("wheel");
    const ctx = canvas.getContext("2d");
    const button = document.getElementById("spinButton");
    const result = document.getElementById("result");
    const center = canvas.width / 2;
    const radius = center - 12;
    const slice = (Math.PI * 2) / options.length;
    let rotation = 0;
    let spinning = false;

    function drawWheel() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      options.forEach((option, i) => {
        const start = rotation + i * slice - Math.PI / 2;
        const end = start + slice;
        ctx.beginPath();
        ctx.moveTo(center, center);
        ctx.arc(center, center, radius, start, end);
        ctx.closePath();
        ctx.fillStyle = option.color;
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 6;
        ctx.stroke();

        ctx.save();
        ctx.translate(center, center);
        ctx.rotate(start + slice / 2);
        ctx.textAlign = "right";
        ctx.textBaseline = "middle";
        ctx.fillStyle = "#20243a";
        ctx.font = "bold 23px system-ui, sans-serif";
        ctx.fillText(option.text, radius - 28, 0, 185);
        ctx.restore();
      });

      ctx.beginPath();
      ctx.arc(center, center, 37, 0, Math.PI * 2);
      ctx.fillStyle = "#ffffff";
      ctx.fill();
      ctx.strokeStyle = "#252943";
      ctx.lineWidth = 5;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(center, center, 10, 0, Math.PI * 2);
      ctx.fillStyle = "#6655e8";
      ctx.fill();
    }

    function spin() {
      if (spinning) return;
      spinning = true;
      button.disabled = true;
      result.textContent = "Kolo se točí…";

      const startRotation = rotation;
      const extraTurns = 5 + Math.random() * 4;
      const targetRotation = startRotation + extraTurns * Math.PI * 2 + Math.random() * Math.PI * 2;
      const duration = 4200;
      const startTime = performance.now();

      function animate(now) {
        const elapsed = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - elapsed, 4);
        rotation = startRotation + (targetRotation - startRotation) * eased;
        drawWheel();

        if (elapsed < 1) {
          requestAnimationFrame(animate);
        } else {
          // Horní ukazatel míří na úhel -PI/2. Převedeme ho na úhel kola.
          const normalized = ((Math.PI * 2 - ((rotation % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2))) % (Math.PI * 2));
          const index = Math.floor(normalized / slice) % options.length;
          result.innerHTML = `Padlo na: <span>${options[index].text}</span>!`;
          spinning = false;
          button.disabled = false;
        }
      }
      requestAnimationFrame(animate);
    }

    button.addEventListener("click", spin);
    drawWheel();
  </script>
</body>
</html>
